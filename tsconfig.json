{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-e2e/worker-1/types/**/*.ts",
    ".next-e2e/worker-1/dev/types/**/*.ts",
    ".next-e2e/worker-2/types/**/*.ts",
    ".next-e2e/worker-2/dev/types/**/*.ts",
    ".next-e2e/worker-3/types/**/*.ts",
    ".next-e2e/worker-3/dev/types/**/*.ts",
    ".next-e2e/worker-4/types/**/*.ts",
    ".next-e2e/worker-4/dev/types/**/*.ts",
    ".next-e2e/worker-5/types/**/*.ts",
    ".next-e2e/worker-5/dev/types/**/*.ts",
    ".next-e2e/worker-6/types/**/*.ts",
    ".next-e2e/worker-6/dev/types/**/*.ts",
    ".next-e2e/worker-7/types/**/*.ts",
    ".next-e2e/worker-7/dev/types/**/*.ts",
    ".next-e2e/worker-8/types/**/*.ts",
    ".next-e2e/worker-8/dev/types/**/*.ts",
    ".next-e2e/production/types/**/*.ts",
    ".next-e2e/production/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
