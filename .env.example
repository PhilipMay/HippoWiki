# Local environment. Copy this file to `.env`: cp .env.example .env
# `.env` stays on the development machine.

# Used by scripts/db.sh to create the PostgreSQL container.
POSTGRES_DB=hippowiki
POSTGRES_USER=hippowiki
POSTGRES_PASSWORD=hippowiki

# Used by the application. Must match the values above. The end-to-end tests do not use it; they start their own
# database container (see e2e/support/container.ts).
DATABASE_URL=postgresql://hippowiki:hippowiki@localhost:5432/hippowiki

# Read only by the admin setup (`npm run admin:setup`, in a container image-admin.sh), never by the server: the
# password of the admin account `admin` when the setup creates it. 8 to 128 characters. Choose a password of your own,
# for example with `openssl rand -base64 24`; never use a value from this file or the README. Left empty, the setup
# fails until a password is set. Once the admin exists, the variable is ignored; the admin changes the password at the
# first login. `npm run db:seed` does not need it.
HIPPOWIKI_ADMIN_PASSWORD=

# Optional, `true` or `false` (default): logs the forwarding headers of every request, such as X-Forwarded-For, to
# check a reverse proxy (see "Configuration" in spec/container-image.md).
# HIPPOWIKI_LOG_CLIENT_ADDRESS=false
# Optional, one digit from 0 (default) to 9: how many reverse proxies are in front of the server. With 1 or more the
# wait after failed logins counts per client address from X-Forwarded-For; only set it when the server is reachable
# through the reverse proxy alone (see "Configuration" in spec/container-image.md).
# HIPPOWIKI_TRUSTED_PROXIES=0
# Optional: the public address of the wiki, as browsers and the connectors of AI assistants reach it. An https:// URL
# without a path, or http:// only for localhost, 127.0.0.1 and [::1]. It switches on OAuth for MCP clients, such as
# the connectors of claude.ai and ChatGPT; without it there is no OAuth and no MCP server. Any other value stops the
# server.
# HIPPOWIKI_PUBLIC_URL=https://wiki.example.com
# Optional, the limits of the MCP addresses (see "Configuration" in spec/container-image.md); whole numbers in plain
# digits, any other value stops the server. The body limit of a request in bytes, from 1048576 (1 MiB, default) to
# 16777216 (16 MiB):
# HIPPOWIKI_MCP_BODY_LIMIT=1048576
# How many MCP requests a user may send at once, from 1 to 10000 (default 60), and how many the budget of a user gains
# per minute, from 1 to 100000 (default 300):
# HIPPOWIKI_MCP_RATE_BURST=60
# HIPPOWIKI_MCP_RATE_PER_MINUTE=300
# Optional: the directory that keeps the contents of uploaded files (images and PDFs), relative to the working directory
# of the server or absolute. Without it, or when it is missing or cannot be written, the wiki works without files and
# logs a warning at its start. `npm run dev` uses `files/` of the project, which Git ignores; create it first with
# `mkdir files`. An empty value stops the server.
HIPPOWIKI_FILES_DIR=files
# Optional, the size limit of an uploaded file in bytes, a whole number in plain digits from 1048576 (1 MiB) to
# 1073741824 (1 GiB), default 26214400 (25 MiB); any other value stops the server.
# HIPPOWIKI_FILE_SIZE_LIMIT=26214400
