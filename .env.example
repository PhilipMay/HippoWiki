# Local environment. Copy this file to `.env`: cp .env.example .env
# `.env` stays on the development machine.

# Used by scripts/db.sh to create the PostgreSQL container.
POSTGRES_DB=hippowiki
POSTGRES_USER=hippowiki
POSTGRES_PASSWORD=hippowiki

# Used by the application. Must match the values above. The end-to-end tests do not use it; they start their own
# database container (see e2e/support/container.ts).
DATABASE_URL=postgresql://hippowiki:hippowiki@localhost:5432/hippowiki

# Read only by the admin setup (`npm run admin:setup`, in a container image-admin.sh), never by the server: the
# password of the admin account `admin` when the setup creates it. 8 to 128 characters. Once the admin exists, the
# variable is ignored; the admin changes the password at the first login. `npm run db:seed` does not need it.
HIPPOWIKI_ADMIN_PASSWORD=change-me-at-first-login

# Optional, `true` or `false` (default): logs the forwarding headers of every request, such as X-Forwarded-For, to
# check a reverse proxy (see "Configuration" in spec/container-image.md).
# HIPPOWIKI_LOG_CLIENT_ADDRESS=false
# Optional, one digit from 0 (default) to 9: how many reverse proxies are in front of the server. With 1 or more the
# wait after failed logins counts per client address from X-Forwarded-For; only set it when the server is reachable
# through the reverse proxy alone (see "Configuration" in spec/container-image.md).
# HIPPOWIKI_TRUSTED_PROXIES=0
# Optional: the public address of the wiki, as browsers and the connectors of AI assistants reach it. An https:// URL
# without a path, or http:// only for localhost, 127.0.0.1 and [::1]. It switches on OAuth for MCP clients, such as
# the connectors of claude.ai and ChatGPT; without it only API tokens work. Any other value stops the server.
# HIPPOWIKI_PUBLIC_URL=https://wiki.example.com
