// Prisma schema. Connection settings live in prisma.config.ts.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  // For the unique index on the names of pages placed directly in a folder (`where` in `@@unique`).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// A folder: the top level of the content structure.
model Folder {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The part of the folder's address `/folders/<name>`; unique across the wiki.
  name           String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  /// The user who last edited the folder: changes on the same writes as `updatedAt`, so that both describe the same
  /// change. Creating it counts as an edit.
  lastEditedById String   @db.Uuid
  lastEditedBy   User     @relation("FolderLastEditedBy", fields: [lastEditedById], references: [id], onDelete: Restrict)
  tabs           Tab[]
  pages          Page[]
}

/// A tab: an optional section inside a folder.
model Tab {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  folderId       String   @db.Uuid
  folder         Folder   @relation(fields: [folderId], references: [id], onDelete: Restrict)
  /// The tab's part of its address `/folders/<folder>/<name>`; unique among the tabs of its folder.
  name           String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  /// The user who last edited the tab: changes on the same writes as `updatedAt`, so that both describe the same
  /// change. Creating it counts as an edit.
  lastEditedById String   @db.Uuid
  lastEditedBy   User     @relation("TabLastEditedBy", fields: [lastEditedById], references: [id], onDelete: Restrict)
  pages          Page[]

  @@unique([folderId, name])
  // Target of the composite foreign key of `Page`, which makes sure a page's tab belongs to the page's folder.
  @@unique([id, folderId])
}

/// A wiki page with its Markdown source. It lives in exactly one folder: directly in it or in one of its tabs.
model Page {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Derived from the content's first heading (`# Title`) on every save; never entered directly.
  title          String
  /// The page's part of its address, followed by `.md`: `/folders/<folder>/<name>.md` or, in a tab,
  /// `/folders/<folder>/<tab>/<name>.md`. Unique among the pages of its tab or, without a tab, among the pages placed
  /// directly in its folder.
  name           String
  /// Markdown source of the page.
  content        String
  folderId       String    @db.Uuid
  folder         Folder    @relation(fields: [folderId], references: [id], onDelete: Restrict)
  /// The tab the page lives in; without one, the page is placed directly in its folder.
  tabId          String?   @db.Uuid
  /// The foreign key includes `folderId`, so the tab is always one of the page's folder.
  tab            Tab?      @relation(fields: [tabId, folderId], references: [id, folderId], onDelete: Restrict)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  /// When the page was deleted, or `null` for a page that is not deleted. A deleted page keeps its folder but has no
  /// tab, because its place inside the folder is forgotten; it is missing from every list and every page address.
  deletedAt      DateTime? @db.Timestamptz(3)
  /// The user who last edited the page: changes on the same writes as `updatedAt`, so that both describe the same
  /// change. Creating, editing, moving or renaming, deleting and restoring the page count as edits; for a deleted page
  /// it is the user who deleted it.
  lastEditedById String    @db.Uuid
  lastEditedBy   User      @relation("PageLastEditedBy", fields: [lastEditedById], references: [id], onDelete: Restrict)

  // Pages in a tab: unique within the tab. Deleted pages have no tab, so they are not covered.
  @@unique([tabId, name])
  // Pages placed directly in a folder and not deleted: unique among those pages only. Deleted pages never block a name.
  @@unique([folderId, name], where: { tabId: null, deletedAt: null })
}

/// A user account. The table has the shape Better Auth expects for its `user` model with the `username` plugin; Better
/// Auth reads it through its Prisma adapter, and the users service writes it with Prisma.
model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Better Auth needs a display name; it is always the same as `username`.
  name               String
  /// Better Auth needs an email address; it is the hidden placeholder `<username>@users.hippowiki.invalid`, which is
  /// never shown and never gets mail.
  email              String    @unique
  emailVerified      Boolean   @default(false)
  /// A field of Better Auth that HippoWiki does not use.
  image              String?
  /// The user name people log in with; unique across the wiki. The admin is the user named `admin`.
  username           String    @unique
  /// A field of the `username` plugin that HippoWiki does not use.
  displayUsername    String?
  /// Whether the user still has the first password and must set an own one before doing anything else.
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  sessions           Session[]
  accounts           Account[]
  /// The folders, tabs and pages the user edited last.
  lastEditedFolders  Folder[]  @relation("FolderLastEditedBy")
  lastEditedTabs     Tab[]     @relation("TabLastEditedBy")
  lastEditedPages    Page[]    @relation("PageLastEditedBy")
}

/// A login of a user in one browser, in the shape of the `session` model of Better Auth.
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  /// The value of the session cookie.
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A way a user can log in, in the shape of the `account` model of Better Auth. Every user has exactly one: the
/// credential account (`providerId` is `credential`, `accountId` the id of the user) with the hash of the password.
model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  /// The encoded Argon2id hash of the password (see `src/lib/password-hash.ts`).
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

/// The `verification` model of Better Auth, for values that are valid for a short time. HippoWiki uses no feature that
/// writes it; the table exists because Better Auth expects it.
model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

/// The secret that signs the session cookies. The table has a single row: `getAuth()` creates it on first use, and a
/// check constraint in the migration allows no second one. Without the row every session cookie would be invalid, so
/// it is never deleted.
model AuthSecret {
  /// Always 1.
  id        Int      @id @default(1)
  secret    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

/// The failed logins in a row for a submitted user name from one client address group, for the wait after too many of
/// them. Each pair of a name and a group has its own count, so a stranger's failures do not make the owner of the
/// name wait at another address; the logins per name from all groups together are limited by `LoginWindow`. It has no
/// relation to `User`: unknown names are counted too, so that the wait does not tell which names exist. A login is
/// counted before its password is checked. A successful login deletes the row of its name and group; a row whose last
/// failure is more than a day old is deleted by the next counted login of any name.
model LoginAttempt {
  /// The submitted user name; always one that follows the name rule.
  username      String
  /// The client address group the logins came from (`src/lib/client-address.ts`): `shared`, an IPv4 address or the
  /// /64 of an IPv6 address.
  clientAddress String
  /// How many logins for the name from the group have failed in a row, including the ones whose password is being
  /// checked.
  failures      Int
  /// When the last of them was counted; the wait counts from here.
  lastFailedAt  DateTime @db.Timestamptz(3)

  @@id([username, clientAddress])
  // For deleting the rows whose last failure is more than a day old.
  @@index([lastFailedAt])
}

/// The logins counted for a submitted user name in the current hour, from all client addresses together, for the limit
/// per name. It has no relation to `User`, like `LoginAttempt`: unknown names are counted too. A login is counted
/// before its password is checked; when the hour is over, the next login starts a new window. A successful login
/// deletes the row, and so does the next counted login of any name once the hour is over.
model LoginWindow {
  /// The submitted user name; always one that follows the name rule.
  username  String   @id
  /// How many logins for the name were counted since `startedAt`, including the ones whose password is being checked.
  attempts  Int
  /// When the first of them was counted; the window ends one hour later.
  startedAt DateTime @db.Timestamptz(3)

  // For deleting the windows whose hour is over.
  @@index([startedAt])
}
