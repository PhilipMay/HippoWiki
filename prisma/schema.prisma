// Prisma schema. Connection settings live in prisma.config.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// A folder: the top level of the content structure.
model Folder {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The part of the folder's address `/folders/<name>`; unique across the wiki.
  name      String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// A wiki page with its Markdown source.
model Page {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Derived from the content's first heading (`# Title`) on every save; never entered directly.
  title     String
  /// Last part of the page address `/pages/<slug>`.
  slug      String   @unique
  /// Markdown source of the page.
  content   String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
