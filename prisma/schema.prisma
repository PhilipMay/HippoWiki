// Prisma schema. Connection settings live in prisma.config.ts.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  // For the unique index on the names of pages placed directly in a folder (`where` in `@@unique`).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// A folder: the top level of the content structure.
model Folder {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The part of the folder's address `/folders/<name>`; unique across the wiki.
  name           String        @unique
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  /// The user who last edited the folder: changes on the same writes as `updatedAt`, so that both describe the same
  /// change. Creating it counts as an edit.
  lastEditedById String        @db.Uuid
  lastEditedBy   User          @relation("FolderLastEditedBy", fields: [lastEditedById], references: [id], onDelete: Restrict)
  /// How the folder was last changed (`web` or `mcp`): changes on the same writes as the last editor.
  lastEditedVia  ChangeChannel
  tabs           Tab[]
  pages          Page[]
  /// The roles of the users on the folder.
  roles          FolderRole[]
  /// The grants to OAuth clients at the MCP addresses of the folder, and the codes that stand for them.
  oauthGrants    OAuthGrant[]
  oauthCodes     OAuthCode[]
  /// The words of the pages of the folder, for search.
  searchWords    SearchWord[]
  /// The wiki links of the pages of the folder.
  pageLinks      PageLink[]
  /// The files of the folder, placed directly in it or in one of its tabs, deleted ones included.
  files          File[]
}

/// The role of a user on a folder (`src/features/folder-roles/roles.ts`): what the user may see and do with the folder
/// in the browser. A user has at most one role per folder, and a user without a role does not see the folder. A trigger
/// in the migration refuses every role of an admin, so that no code, command or crafted request gives an admin a role.
model FolderRole {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  folderId  String         @db.Uuid
  folder    Folder         @relation(fields: [folderId], references: [id], onDelete: Restrict)
  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      FolderRoleType
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([folderId, userId])
  // For the folders of a user.
  @@index([userId])
}

/// How a folder, tab or page was last changed: in the browser (`web`) or by an AI app through MCP (`mcp`). Content
/// stored before the channel existed got `web`.
enum ChangeChannel {
  web
  mcp
}

/// A role on a folder, from the lowest to the highest (`src/features/folder-roles/roles.ts`).
enum FolderRoleType {
  reader
  writer
  manager
  owner
}

/// A tab: an optional section inside a folder.
model Tab {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  folderId       String        @db.Uuid
  folder         Folder        @relation(fields: [folderId], references: [id], onDelete: Restrict)
  /// The tab's part of its address `/folders/<folder>/<name>`; unique among the tabs of its folder.
  name           String
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  /// The user who last edited the tab: changes on the same writes as `updatedAt`, so that both describe the same
  /// change. Creating it counts as an edit.
  lastEditedById String        @db.Uuid
  lastEditedBy   User          @relation("TabLastEditedBy", fields: [lastEditedById], references: [id], onDelete: Restrict)
  /// How the tab was last changed (`web` or `mcp`): changes on the same writes as the last editor.
  lastEditedVia  ChangeChannel
  pages          Page[]
  /// The files placed in the tab; a deleted file has no tab.
  files          File[]

  @@unique([folderId, name])
  // Target of the composite foreign keys of `Page` and `File`, which make sure the tab of a page or file belongs to
  // its folder.
  @@unique([id, folderId])
}

/// A wiki page with its Markdown source. It lives in exactly one folder: directly in it or in one of its tabs.
model Page {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Derived from the content's first heading (`# Title`) on every save; never entered directly.
  title              String
  /// The page's part of its address, followed by `.md`: `/folders/<folder>/<name>.md` or, in a tab,
  /// `/folders/<folder>/<tab>/<name>.md`. Unique among the pages of its tab or, without a tab, among the pages placed
  /// directly in its folder.
  name               String
  /// Markdown source of the page.
  content            String
  folderId           String                   @db.Uuid
  folder             Folder                   @relation(fields: [folderId], references: [id], onDelete: Restrict)
  /// The tab the page lives in; without one, the page is placed directly in its folder.
  tabId              String?                  @db.Uuid
  /// The foreign key includes `folderId`, so the tab is always one of the page's folder.
  tab                Tab?                     @relation(fields: [tabId, folderId], references: [id, folderId], onDelete: Restrict)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)
  /// When the page was deleted, or `null` for a page that is not deleted. A deleted page keeps its folder but has no
  /// tab, because its place inside the folder is forgotten; it is missing from every list and every page address.
  deletedAt          DateTime?                @db.Timestamptz(3)
  /// The user who last edited the page: changes on the same writes as `updatedAt` and `version`, so that all three
  /// describe the same change. Creating, editing, moving or renaming, deleting and restoring the page count as edits;
  /// a content save, move or rename that changes nothing writes nothing and is no edit. For a deleted page it is the
  /// user who deleted it.
  lastEditedById     String                   @db.Uuid
  lastEditedBy       User                     @relation("PageLastEditedBy", fields: [lastEditedById], references: [id], onDelete: Restrict)
  /// How the page was last changed (`web` or `mcp`): changes on the same writes as the last editor; for a deleted page
  /// it is how the page was deleted.
  lastEditedVia      ChangeChannel
  /// The state of the page: 1 when it is created, counted up by every later write of the page, in the same write that
  /// changes `updatedAt` and the last editor; a content save, move or rename that changes nothing writes nothing and
  /// keeps it. A content save, move, rename or delete states the version it is based on and is refused if that is not
  /// the stored one.
  version            Int                      @default(1)
  /// The revisions of the content, one per content change; kept for as long as the page exists.
  revisions          PageRevision[]
  /// What search reads of the content (`src/features/search/index-data.ts`), stored by every write of the content:
  /// the content as plain text without the title heading, with code and the addresses of links. `null` for a page
  /// that was never derived, which has no vector and no words until the server derives it at its start.
  searchText         String?
  /// The text search configuration of PostgreSQL that stems the words of the page, detected from its prose, or
  /// `simple`: one of `SEARCH_LANGUAGES` of `src/features/search/language.ts`, which a check constraint in the
  /// migration keeps. `null` together with `searchText`.
  searchLanguage     String?
  /// The version of the code that derived `searchText` and `searchLanguage` (`SEARCH_INDEX_VERSION`); 0 for a page
  /// that was never derived. The server derives every page whose version differs before it serves.
  searchIndexVersion Int                      @default(0)
  /// The search vector of the title, the name and `searchText` with the configuration of the page, which a trigger
  /// of the migration builds on every write of them; never written by the application.
  searchVector       Unsupported("tsvector")?
  /// The wiki links of the content, stored by every write of the content (`src/features/pages/links-service.ts`).
  links              PageLink[]
  /// The version of the code that derived `links` (`LINK_INDEX_VERSION` of `src/features/pages/wiki-links.ts`); 0 for
  /// a page that was never derived. The server derives every page whose version differs before it serves.
  linkIndexVersion   Int                      @default(0)

  // Pages in a tab: unique within the tab. Deleted pages have no tab, so they are not covered.
  @@unique([tabId, name])
  // Pages placed directly in a folder and not deleted: unique among those pages only. Deleted pages never block a name.
  @@unique([folderId, name], where: { tabId: null, deletedAt: null })
  // For search, which reads the pages of one folder that are not deleted, and matches them through their vectors.
  @@index([folderId], where: { deletedAt: null })
  @@index([searchVector], type: Gin, where: { deletedAt: null })
}

/// A word of the pages of a folder that are not deleted, with the number of pages that hold it, for search: the
/// words of a search are looked up here by their start, as a part of a word and by similarity, so that no search
/// compares a word with the whole text of every page. Derived data, which the trigger of `Page` keeps current in the
/// same write as the page (the migration of the search index); never written by the application. A word that no
/// page holds has no row. The words show nothing that a user of the folder could not read, because every role reads
/// every page of its folder.
model SearchWord {
  folderId String @db.Uuid
  folder   Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  /// A word as the text search parser of PostgreSQL splits the title, the name and the search text, in lower case.
  word     String
  /// The number of pages of the folder that are not deleted and hold the word; always at least 1.
  pages    Int

  @@id([folderId, word])
  // Parts of words and typos, with `pg_trgm`.
  @@index([word(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// A wiki link of a page: one row per distinct valid target of its content (`src/features/pages/wiki-links.ts`), so that
/// the pages that link to a page, for its backlinks and for the update of the links when it is renamed, are one indexed
/// read. Derived data, stored in the same write as the content of the page (`src/features/pages/links-service.ts`),
/// for deleted pages too, so that a restore needs nothing; the reads leave deleted pages out. A target names a page of
/// the folder of the linking page by its name and place, or a file by its name with its extension, whether it exists or
/// not.
model PageLink {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The page that holds the link. Pages are never removed, only soft deleted.
  pageId   String  @db.Uuid
  page     Page    @relation(fields: [pageId], references: [id], onDelete: Restrict)
  /// The folder of the linking page, which is the folder of the target.
  folderId String  @db.Uuid
  folder   Folder  @relation(fields: [folderId], references: [id], onDelete: Restrict)
  /// The name of the tab of the target, or `null` for a page or file placed directly in the folder.
  tabName  String?
  /// The name of the page of the target, or of the file with its extension (`diagram.png`), which no page name has.
  pageName String

  // The links of a page, which a write of its content replaces.
  @@index([pageId])
  // The pages that link to a name and place of a folder.
  @@index([folderId, tabName, pageName])
}

/// A revision of a page: its content and title after a content change, stored in the same write as the change
/// (`src/features/pages/service.ts`). Creating a page records revision 1, every content save that changes the content
/// the next one, a revert one that names the revision it went back to, and an update of its wiki links after a move or
/// rename one that is marked as such; moving, renaming, deleting and restoring a page record none of their own. A revision is never changed or deleted.
model PageRevision {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The page of the revision. Pages are never removed, only soft deleted, so the revisions stay with them.
  pageId       String        @db.Uuid
  page         Page          @relation(fields: [pageId], references: [id], onDelete: Restrict)
  /// The number of the revision: 1 for the oldest, counted up per page; unique per page.
  number       Int
  /// The title of the page after the change, derived from the content like that of the page.
  title        String
  /// The Markdown source of the page after the change.
  content      String
  /// When the change was made.
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  /// The user who made the change, like the last editor of the page; users are not deleted.
  userId       String        @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// How the change was made (`web` or `mcp`).
  via          ChangeChannel
  /// The number of the revision a revert went back to; `null` for every revision that no revert recorded.
  revertedTo   Int?
  /// Whether the revision was recorded by the update of the wiki links of the page after a move or rename of a page or
  /// a rename of a tab (`updateLinks()` of `src/features/pages/links-service.ts`), by the user who moved or renamed.
  linksUpdated Boolean       @default(false)

  // The order of the history and the uniqueness of the number per page.
  @@unique([pageId, number])
}

/// The type of a file, decided at its upload from its content, never from its name or the type the browser claims
/// (`src/features/files/types.ts`). It is fixed by the extension of the name of the file: every version has it.
enum FileType {
  png
  jpeg
  gif
  webp
  pdf
}

/// A file of a folder, an image or a PDF: an item of its own next to the pages, placed directly in the folder or in one
/// of its tabs. Its contents are the blobs of its versions in the files directory (`src/features/files/store.ts`).
model File {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The name with the extension of its type, the file's part of its addresses `/files/<folder>/[<tab>/]<name.ext>`
  /// and `/folders/<folder>/[<tab>/]<name.ext>`. Unique among the files of its tab or, without a tab, among the files
  /// placed directly in its folder; a page of the same name without the extension may sit next to it.
  name           String
  type           FileType
  folderId       String        @db.Uuid
  folder         Folder        @relation(fields: [folderId], references: [id], onDelete: Restrict)
  /// The tab the file lives in; without one, the file is placed directly in its folder.
  tabId          String?       @db.Uuid
  /// The foreign key includes `folderId`, so the tab is always one of the file's folder.
  tab            Tab?          @relation(fields: [tabId, folderId], references: [id, folderId], onDelete: Restrict)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  /// When the file was deleted, or `null` for a file that is not deleted. A deleted file keeps its folder and its
  /// versions but has no tab, like a deleted page; it is missing from every list and from both of its addresses.
  deletedAt      DateTime?     @db.Timestamptz(3)
  /// The user who last changed the file: changes on the same writes as `updatedAt` and `lockVersion`. Uploading it, a
  /// new version, a revert, a move or rename, a delete and a restore count as changes; for a deleted file it is the
  /// user who deleted it.
  lastEditedById String        @db.Uuid
  lastEditedBy   User          @relation("FileLastEditedBy", fields: [lastEditedById], references: [id], onDelete: Restrict)
  /// How the file was last changed (`web` or `mcp`): changes on the same writes as the last editor.
  lastEditedVia  ChangeChannel
  /// The state of the file, for optimistic locking as the version of a page: 1 when it is uploaded, counted up by every
  /// later stored change of the file in the same write that changes `updatedAt` and the last editor. A new version, a
  /// revert, a move, a rename and a delete state the lock version they are based on and are refused if that is not
  /// the stored one.
  lockVersion    Int           @default(1)
  /// The stored contents of the file, one per upload or revert; the newest is the current one.
  versions       FileVersion[]

  // Files in a tab: unique within the tab. Deleted files have no tab, so they are not covered.
  @@unique([tabId, name])
  // Files placed directly in a folder and not deleted: unique among those files only. Deleted files never block a name.
  @@unique([folderId, name], where: { tabId: null, deletedAt: null })
  // The files of a folder that are not deleted.
  @@index([folderId], where: { deletedAt: null })
}

/// A version of a file: one of its stored contents, the blob of the SHA-256 in the files directory, stored by an upload
/// or a revert. A version is never changed or deleted.
model FileVersion {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The file of the version. Files are never removed, only soft deleted, so the versions stay with them.
  fileId     String        @db.Uuid
  file       File          @relation(fields: [fileId], references: [id], onDelete: Restrict)
  /// The number of the version: 1 for the first upload, counted up per file; the newest is the current version.
  number     Int
  /// The SHA-256 of the content in 64 lowercase hex digits, the name of its blob and its `ETag`.
  sha256     String
  /// The size of the content in bytes.
  size       Int
  /// The width and height of an image in pixels, upright as it shows, of one frame of an animated image; `null` for a
  /// PDF.
  width      Int?
  height     Int?
  /// When the version was stored.
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  /// The user who uploaded the version or reverted to it.
  userId     String        @db.Uuid
  user       User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// How the version was stored (`web` or `mcp`).
  via        ChangeChannel
  /// The number of the version a revert went back to, whose blob this version holds; `null` for an upload.
  revertedTo Int?

  // The order of the versions and the uniqueness of the number per file.
  @@unique([fileId, number])
  // Whether a version holds a blob, before the blob of a failed upload is removed.
  @@index([sha256])
}

/// A user account. The table has the shape Better Auth expects for its `user` model with the `username` plugin; Better
/// Auth reads it through its Prisma adapter, and the users service writes it with Prisma.
model User {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Better Auth needs a display name; it is always the same as `username`.
  name               String
  /// Better Auth needs an email address; it is the hidden placeholder `<username>@users.hippowiki.invalid`, which is
  /// never shown and never gets mail.
  email              String         @unique
  emailVerified      Boolean        @default(false)
  /// A field of Better Auth that HippoWiki does not use.
  image              String?
  /// The user name people log in with; unique across the wiki.
  username           String         @unique
  /// What the account may do: an admin manages the accounts, a user works with the content. Chosen when the account is
  /// created and never changed: a trigger in the migration refuses every update that changes it. No default, so that
  /// every write that creates a user has to name it.
  type               UserType
  /// A field of the `username` plugin that HippoWiki does not use.
  displayUsername    String?
  /// Whether the user still has the first password and must set an own one before doing anything else.
  mustChangePassword Boolean        @default(true)
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
  sessions           Session[]
  accounts           Account[]
  /// The folders, tabs and pages the user edited last.
  lastEditedFolders  Folder[]       @relation("FolderLastEditedBy")
  lastEditedTabs     Tab[]          @relation("TabLastEditedBy")
  lastEditedPages    Page[]         @relation("PageLastEditedBy")
  /// The revisions of pages the user made.
  pageRevisions      PageRevision[]
  /// The files the user changed last, and the versions of files the user uploaded.
  lastEditedFiles    File[]         @relation("FileLastEditedBy")
  fileVersions       FileVersion[]
  /// The grants of the user to OAuth clients, the connected apps of the account page.
  grants             OAuthGrant[]
  /// The authorization codes that wait to be exchanged for a grant of the user.
  oauthCodes         OAuthCode[]
  /// The roles of the user on folders; an admin has none.
  folderRoles        FolderRole[]
}

/// The type of an account (`src/features/users/user-type.ts`).
enum UserType {
  admin
  user
}

/// A login of a user in one browser, in the shape of the `session` model of Better Auth.
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  /// The value of the session cookie.
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A way a user can log in, in the shape of the `account` model of Better Auth. Every user has exactly one: the
/// credential account (`providerId` is `credential`, `accountId` the id of the user) with the hash of the password.
model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  /// The encoded Argon2id hash of the password (see `src/lib/password-hash.ts`).
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

/// The grant of a user to an OAuth client, such as the connector of an AI assistant: a connected app on the account
/// page (`src/features/grants/service.ts`). It stands for its user at the one MCP address of its folder and role, with
/// at most what that role allows (there are no scopes), until it expires or is revoked; revoking deletes the row. The client holds a short-lived access token and a refresh token that changes
/// with every use, and the row holds the hashes of the current ones; a token is never stored.
model OAuthGrant {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String         @db.Uuid
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The name of the client when the grant was made, shown on the account page.
  name                 String
  /// The folder of the MCP address the grant connects to (`/mcp/<folder-uuid>/<role>`). Deleting the folder deletes
  /// its grants: a grant is no content.
  folderId             String         @db.Uuid
  folder               Folder         @relation(fields: [folderId], references: [id], onDelete: Cascade)
  /// The role of the MCP address: the most the app may do, never more than the user's current role on the folder.
  /// Only `reader`, `writer` or `manager`, which a check constraint in the migration keeps: Owner is no role of MCP.
  role                 FolderRoleType
  /// When the grant ends: it can no longer be refreshed, and its access token stops working.
  expiresAt            DateTime       @db.Timestamptz(3)
  /// When the access token was last used, at most once a minute; `null` for a grant that was never used.
  lastUsedAt           DateTime?      @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  /// The OAuth client the grant is given to. Deleting the client deletes its grants.
  clientId             String         @db.Uuid
  client               OAuthClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// The SHA-256 hash of the current refresh token, in hex (`src/features/oauth/secret.ts`). A refresh replaces it; a
  /// refresh token with another hash is an old one and revokes the grant.
  refreshTokenHash     String?
  /// The SHA-256 hash of the current access token, in hex. A request with an access token is looked up by it. A
  /// refresh replaces it, so the previous access token stops working.
  accessTokenHash      String?        @unique
  /// When the current access token stops working.
  accessTokenExpiresAt DateTime?      @db.Timestamptz(3)

  @@index([userId])
  @@index([clientId])
  @@index([folderId])
}

/// An OAuth client: an application, such as the connector of an AI assistant, that asks a user for access to the wiki
/// (`src/features/oauth/service.ts`). All clients are public: none has a secret.
///
/// - A registered client (dynamic client registration) has no `metadataUrl`; its `client_id` is its `id`.
/// - A client from a metadata document (Client ID Metadata Document) has the URL of the document, which is its
///   `client_id`; the row is the document as it was fetched last.
///
/// Anyone can register a client, so a client that no grant and no code names is deleted after a day.
model OAuthClient {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The URL of the metadata document of the client; `null` for a registered client.
  metadataUrl  String?      @unique
  /// When the metadata document was fetched last; `null` for a registered client.
  fetchedAt    DateTime?    @db.Timestamptz(3)
  /// Until when the fetched document is used without fetching it again; `null` for a registered client.
  freshUntil   DateTime?    @db.Timestamptz(3)
  /// The name the client gave itself, shown on the consent page and as the name of its grants. Chosen by the client,
  /// so it proves nothing.
  name         String
  /// The addresses the client may be sent back to with a code.
  redirectUris String[]
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  codes        OAuthCode[]
  grants       OAuthGrant[]

  // For deleting the clients that are more than a day old and that nothing names.
  @@index([createdAt])
}

/// An authorization code: what a client gets when a user approves it on the consent page, and exchanges once for a
/// grant. The code itself is never stored, only its hash. The row is deleted when the code is exchanged, also when
/// the exchange fails; a code that was never exchanged is deleted after it has expired.
model OAuthCode {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The SHA-256 hash of the code, in hex (`src/features/oauth/secret.ts`).
  codeHash      String         @unique
  clientId      String         @db.Uuid
  client        OAuthClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// The user who approved the client.
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The redirect address of the authorization request; the exchange must name the same one.
  redirectUri   String
  /// The PKCE challenge of the authorization request (`S256`); the exchange must show its verifier.
  codeChallenge String
  /// The folder and the role of the MCP address of the grant the code stands for, as in `OAuthGrant`: only `reader`,
  /// `writer` or `manager`, which a check constraint in the migration keeps.
  folderId      String         @db.Uuid
  folder        Folder         @relation(fields: [folderId], references: [id], onDelete: Cascade)
  role          FolderRoleType
  /// How long the grant lasts, as the user chose it on the consent page: `30d`, `90d` or `365d`.
  lifetime      String
  /// When the code stops working, ten minutes after it was created.
  expiresAt     DateTime       @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)

  @@index([clientId])
  @@index([userId])
  @@index([folderId])
  // For deleting the codes that have expired.
  @@index([expiresAt])
}

/// The `verification` model of Better Auth, for values that are valid for a short time. HippoWiki uses no feature that
/// writes it; the table exists because Better Auth expects it.
model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

/// The secret that signs the session cookies. The table has a single row: `getAuth()` creates it on first use, and a
/// check constraint in the migration allows no second one. Without the row every session cookie would be invalid, so
/// it is never deleted.
model AuthSecret {
  /// Always 1.
  id        Int      @id @default(1)
  secret    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

/// The failed logins in a row for a submitted user name from one client address group, for the wait after too many of
/// them. Each pair of a name and a group has its own count, so a stranger's failures do not make the owner of the
/// name wait at another address; the logins per name from all groups together are limited by `LoginWindow`. It has no
/// relation to `User`: unknown names are counted too, so that the wait does not tell which names exist. A login is
/// counted before its password is checked. A successful login deletes the row of its name and group; a row whose last
/// failure is more than a day old is deleted by the next counted login of any name.
model LoginAttempt {
  /// The submitted user name; always one that follows the name rule.
  username      String
  /// The client address group the logins came from (`src/lib/client-address.ts`): `shared`, an IPv4 address or the
  /// /64 of an IPv6 address.
  clientAddress String
  /// How many logins for the name from the group have failed in a row, including the ones whose password is being
  /// checked.
  failures      Int
  /// When the last of them was counted; the wait counts from here.
  lastFailedAt  DateTime @db.Timestamptz(3)

  @@id([username, clientAddress])
  // For deleting the rows whose last failure is more than a day old.
  @@index([lastFailedAt])
}

/// The logins counted for a submitted user name in the current hour, from all client addresses together, for the limit
/// per name. It has no relation to `User`, like `LoginAttempt`: unknown names are counted too. A login is counted
/// before its password is checked; when the hour is over, the next login starts a new window. A successful login
/// deletes the row, and so does the next counted login of any name once the hour is over.
model LoginWindow {
  /// The submitted user name; always one that follows the name rule.
  username  String   @id
  /// How many logins for the name were counted since `startedAt`, including the ones whose password is being checked.
  attempts  Int
  /// When the first of them was counted; the window ends one hour later.
  startedAt DateTime @db.Timestamptz(3)

  // For deleting the windows whose hour is over.
  @@index([startedAt])
}

/// The registrations of OAuth clients counted for one client address group in the current hour, for the limit on
/// dynamic client registration, which anyone can call without a login. A registration is counted before the client
/// is written; when the hour is over, the next registration starts a new window, and the row of a group whose hour
/// is over is deleted by a later registration of any group.
model OAuthRegistrationWindow {
  /// The client address group the registrations came from (`src/lib/client-address.ts`): `shared`, an IPv4 address or
  /// the /64 of an IPv6 address.
  clientAddress String   @id
  /// How many registrations from the group were counted since `startedAt`.
  registrations Int
  /// When the first of them was counted; the window ends one hour later.
  startedAt     DateTime @db.Timestamptz(3)

  // For deleting the windows whose hour is over.
  @@index([startedAt])
}
