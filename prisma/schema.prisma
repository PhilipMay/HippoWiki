// Prisma schema. Connection settings live in prisma.config.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// A folder: the top level of the content structure.
model Folder {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The part of the folder's address `/folders/<name>`; unique across the wiki.
  name      String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  pages     Page[]
}

/// A wiki page with its Markdown source. It lives in exactly one folder.
model Page {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Derived from the content's first heading (`# Title`) on every save; never entered directly.
  title     String
  /// The page's part of its address `/folders/<folder>/<name>.md`; unique among the pages of its folder.
  name      String
  /// Markdown source of the page.
  content   String
  folderId  String   @db.Uuid
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([folderId, name])
}
