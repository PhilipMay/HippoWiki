{
  "name": "hippowiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "tsx scripts/check-doc-references.ts",
    "knip": "knip",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:cost",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:cost": "vitest run --project cost",
    "test:integration": "vitest run --project integration",
    "test:integration:cost": "vitest run --project integration-cost",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:production": "HIPPOWIKI_E2E_SERVER=production playwright test",
    "check": "tsx scripts/check.ts",
    "check:all": "tsx scripts/check.ts --all",
    "postinstall": "prisma generate",
    "db:up": "bash scripts/db.sh up",
    "db:down": "bash scripts/db.sh down",
    "db:reset": "bash scripts/db.sh reset",
    "db:psql": "bash scripts/db.sh psql",
    "db:logs": "bash scripts/db.sh logs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "admin:setup": "tsx --env-file-if-exists=.env scripts/admin.ts",
    "build:admin": "esbuild scripts/admin.ts --bundle --platform=node --format=esm --outfile=build/admin.mjs --external:@prisma/client --external:pg --external:pino --external:pino-pretty --external:@node-rs/argon2",
    "search:index": "tsx --env-file-if-exists=.env scripts/search-index.ts",
    "build:search-index": "esbuild scripts/search-index.ts --bundle --platform=node --format=esm --outfile=build/search-index.mjs --external:@prisma/client --external:pg --external:pino --external:pino-pretty",
    "image:build": "bash scripts/image.sh build",
    "image:smoke": "bash scripts/image.sh smoke"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.22",
    "diff": "^9.0.0",
    "eld": "^2.1.1",
    "entities": "^9.0.0",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv": "^18.0.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "knip": "^6.45.1",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
